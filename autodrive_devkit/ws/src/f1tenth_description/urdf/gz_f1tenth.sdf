      <wheel_rl_joint>joint_wheel_rear_left</wheel_rl_joint>
      <wheel_rr_joint>joint_wheel_rear_right</wheel_rr_joint>
      <steer_topic>/autodrive/f1tenth_1/steering_command</steer_topic>
      <throttle_topic>/autodrive/f1tenth_1/throttle_command</throttle_topic>
      <brake_topic>/autodrive/f1tenth_1/brake_command</brake_topic>
      <k_speed>2.0</k_speed>
